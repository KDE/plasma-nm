#: ConnectionItem.qml:62
#, kde-format
msgid "Connect"
msgstr "Poveži se"

#: ConnectionItem.qml:62
#, kde-format
msgid "Disconnect"
msgstr "Prekini vezu"

#: ConnectionItem.qml:90
#, kde-format
msgctxt "Share Wi-Fi network's password or QR code"
msgid "Share"
msgstr "Podijeli"

#: ConnectionItem.qml:96
#, kde-format
msgid "Configure…"
msgstr "Podesi…"

#: ConnectionItem.qml:136
#, kde-format
msgid "Speed"
msgstr "Brzina"

#: ConnectionItem.qml:141
#, kde-format
msgid "Details"
msgstr "Detalji"

#: ConnectionItem.qml:188
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Current download speed is %1 kibibytes per second; current upload speed is "
"%2 kibibytes per second"
msgstr ""
"Trenutna brzina, u kibibajtima u sekundi: preuzimanje %1, otpremanje %2"

#: ConnectionItem.qml:309
#, kde-format
msgctxt "Download and upload rates in some unit per second"
msgid "↓ %1/s, ↑ %2/s"
msgstr "↓ %1/s, ↑ %2/s"

#: ConnectionListPage.qml:33
#, kde-format
msgid "You need to log in to this network"
msgstr "Morate da se prijavite na ovu mrežu"

#: ConnectionListPage.qml:37
#, kde-format
msgctxt "@action:button"
msgid "Log in"
msgstr "Prijavi me"

#: ConnectionListPage.qml:118
#, kde-format
msgid "Airplane mode is enabled"
msgstr "Avionski režim je uključen"

#: ConnectionListPage.qml:122
#, kde-format
msgid "Wi-Fi and mobile data are deactivated"
msgstr "Wi‑Fi i mobilni podaci su isključeni"

#: ConnectionListPage.qml:124
#, kde-format
msgid "Wi-Fi is deactivated"
msgstr "Wi‑Fi je isključen"

#: ConnectionListPage.qml:127
#, kde-format
msgid "Looking for Wi-Fi networks"
msgstr "Tražim Wi‑Fi mreže"

#: ConnectionListPage.qml:130
#, kde-format
msgid "Mobile data is deactivated"
msgstr "Mobilni podaci su isključeni"

#: ConnectionListPage.qml:133
#, kde-format
msgid "No matches"
msgstr "Nema poklapanja"

#: ConnectionListPage.qml:136
#, kde-format
msgid "No available connections"
msgstr "Nema dostupnih veza"

#: ConnectionListPage.qml:145
#, kde-format
msgctxt "@info:placeholder"
msgid "Turn off airplane mode to search for networks"
msgstr "Isključite avionski režim da biste tražili mreže"

#: ConnectionListPage.qml:149
#, kde-format
msgctxt "@info:placeholder"
msgid "Turn on Wi-Fi or mobile data to search for networks"
msgstr "Uključite Wi‑Fi ili mobilne podatke da biste tražili mreže"

#: ConnectionListPage.qml:151
#, kde-format
msgctxt "@info:placeholder"
msgid "Turn on Wi-Fi to search for networks"
msgstr "Uključite Wi‑Fi da biste tražili mreže"

#: ConnectionListPage.qml:154
#, kde-format
msgctxt "@info:placeholder"
msgid "Turn on mobile data to search for networks"
msgstr "Uključite mobilne podatke da biste tražili mreže"

#: DetailsText.qml:40
#, kde-format
msgid "Copy"
msgstr "Kopiraj"

#: main.qml:39
#, kde-format
msgid "Networks"
msgstr "Mreže"

#: main.qml:48
#, kde-format
msgctxt "@info:tooltip"
msgid "Middle-click to turn off Airplane Mode"
msgstr "Srednji klik isključuje avionski režim"

#: main.qml:50
#, kde-format
msgctxt "@info:tooltip"
msgid "Middle-click to turn on Airplane Mode"
msgstr "Srednji klik uključuje avionski režim"

#: main.qml:78 Toolbar.qml:74
#, kde-format
msgid "Enable Wi-Fi"
msgstr "Uključi Wi‑Fi"

#: main.qml:89
#, kde-format
msgid "Enable Mobile Data"
msgstr "Uključi mobilne podatke"

#: main.qml:101
#, kde-format
msgid "Enable Airplane Mode"
msgstr "Uključi avionski režim"

#: main.qml:113
#, kde-format
msgid "Open Network Login Page…"
msgstr "Otvori stranicu za prijavu na mrežu…"

#: main.qml:123
#, kde-format
msgid "&Configure Network Connections…"
msgstr "&Podesi mrežne veze…"

#: PopupDialog.qml:58
#, kde-format
msgctxt "@action:button"
msgid "Return to Network Connections"
msgstr "Nazad na mrežne veze"

#: ShareNetworkQrCodePage.qml:33
#, kde-format
msgid "Scan this QR code with another device to connect to the \"%1\" network."
msgstr ""
"Skenirajte ovaj QR kod drugim uređajem da biste se povezali na mrežu „%1“."

#: ShareNetworkQrCodePage.qml:108
#, kde-format
msgid "Wi-Fi password:"
msgstr "Lozinka Wi‑Fi mreže:"

#: Toolbar.qml:124
#, kde-format
msgid "Enable mobile data"
msgstr "Uključi mobilne podatke"

#: Toolbar.qml:147
#, kde-kuit-format
msgctxt "@info"
msgid "Disable airplane mode<nl/><nl/>This will enable Wi-Fi and Bluetooth"
msgstr "Isključi avionski režim<nl/><nl/>Ovo će uključiti Wi‑Fi i Bluetooth"

#: Toolbar.qml:148
#, kde-kuit-format
msgctxt "@info"
msgid "Enable airplane mode<nl/><nl/>This will disable Wi-Fi and Bluetooth"
msgstr "Uključi avionski režim<nl/><nl/>Ovo će isključiti Wi‑Fi i Bluetooth"

#: Toolbar.qml:176
#, kde-format
msgid "Hotspot"
msgstr "Pristupna tačka"

#: Toolbar.qml:193
#, kde-format
msgctxt "@info:tooltip"
msgid "Cannot create a hotspot because Wi-Fi is disabled."
msgstr "Ne mogu da napravim pristupnu tačku jer je Wi‑Fi isključen."

#: Toolbar.qml:195
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Cannot create a hotspot because all wireless radios are in use. Disconnect "
"from the current Wi-Fi network or connect another wireless radio."
msgstr ""
"Ne mogu da napravim pristupnu tačku jer su svi bežični adapteri zauzeti. "
"Prekini vezu sa tekućom Wi‑Fi mrežom ili priključi još jedan bežični adapter."

#: Toolbar.qml:197
#, kde-format
msgctxt "@info:tooltip"
msgid "Disable Hotspot"
msgstr "Isključi pristupnu tačku"

#: Toolbar.qml:199
#, kde-format
msgctxt "@info:tooltip"
msgid "Create Hotspot"
msgstr "Napravi pristupnu tačku"

#: Toolbar.qml:227
#, kde-format
msgctxt "@action:button"
msgid "Scan Wi-Fi QR Code"
msgstr "Skeniraj QR kod Wi‑Fi mreže"

#: Toolbar.qml:232
#, kde-format
msgctxt "@info:tooltip"
msgid "Scan QR Code to connect to a Wi-Fi network"
msgstr "Skeniraj QR kod za povezivanje na Wi‑Fi mrežu"

#: Toolbar.qml:234
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Install QRCA Barcode Scanner to scan for a QR Code that connects to a Wi-Fi "
"network"
msgstr ""
"Instaliraj skener bar‑kodova QRCA da skeniraš QR kod za povezivanje na Wi‑Fi "
"mrežu"

#: Toolbar.qml:253
#, kde-format
msgid "Configure network connections…"
msgstr "Podesi mrežne veze…"
