msgstr "Ime pristupne tačke ne smije biti prazno"

#: qml/ConfigurationDialog.qml:105
msgid ""
"Hotspot password must either be empty or consist of anywhere from 8 up to 64 "
"characters"
msgstr "Lozinka pristupne tačke mora biti prazna ili imati od 8 do 64 znaka"

#: qml/ConfigurationDialog.qml:106
msgid ""
"Hotspot password must either be empty or consist of one of the following:"
"<ul><li>Exactly 5 or 13 any characters</li><li>Exactly 10 or 26 hexadecimal "
"characters:<br/>abcdef, ABCDEF or 0-9</li></ul>"
msgstr ""
"Lozinka pristupne tačke mora biti prazna ili biti jedno od sljedećeg:"
"<ul><li>Tačno 5 ili 13 bilo kojih znakova</li><li>Tačno 10 ili 26 "
"heksadecimalnih znakova:<br/>abcdef, ABCDEF ili 0–9</li></ul>"

