#. i18n: ectx: property (text), item, widget (KComboBox, privacyCombo)
#: editor/settings/ui/ipv6.ui:206
#, kde-format
msgid "Enabled (prefer temporary addresses)"
msgstr "uključeno (poželjne privremene adrese)"

#. i18n: ectx: property (toolTip), widget (KComboBox, method)
#: editor/settings/ui/ipv6.ui:227 editorqml/qml/ipv6/IPv6Settings.qml:37
#, kde-format
msgid ""
"How to configure the IPv6 address:\n"
"• Automatic: obtain address and DNS automatically (via SLAAC and/or DHCPv6)\n"
"• Automatic (Only addresses): obtain address automatically but configure DNS "
"manually\n"
"• Automatic (Only DHCP): obtain address and DNS via DHCPv6 only (ignore "
"SLAAC)\n"
"• Link-Local: use automatic link-local addressing (fe80::/10)\n"
"• Manual: enter a static IP address\n"
"• Ignored: skip IPv6 configuration but allow connection\n"
"• Disabled: turn off IPv6 completely"
msgstr ""
"Način podešavanja IPv6 adrese:\n"
"• automatski: adresa i DNS dobijaju se automatski (preko SLAAC‑a i/ili "
"DHCPv6)\n"
"• automatski (samo adrese): adresa se dobija automatski, a DNS se podešava "
"ručno\n"
"• automatski (samo DHCP): adresa i DNS dobijaju se samo preko DHCPv6 (SLAAC "
"se ignoriše)\n"
"• veznolokalno: automatsko veznolokalno adresiranje (fe80::/10)\n"
"• ručno: unosi se statička IP adresa\n"
"• ignorisano: IPv6 postava se preskače, ali je veza dozvoljena\n"
"• isključeno: IPv6 se potpuno isključuje"

